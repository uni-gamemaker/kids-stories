# Turso (libSQL over HTTP)
TURSO_DATABASE_URL=libsql://<db-name>-<org>.turso.io
TURSO_AUTH_TOKEN=

# Video merger (the merger/ project, deployed separately on Vercel)
MERGER_API_BASE=https://<your-merger-deployment>.vercel.app

# Optional
# Protect /mcp: use a secret URL (/mcp/<secret>) for AI apps without custom headers, or a bearer token
MCP_URL_SECRET=
MCP_ACCESS_TOKEN=
ADMIN_TOKEN=
KIE_IMAGE_MODEL=
KIE_VIDEO_MODEL=
COMETAPI_IMAGE_MODEL=
COMETAPI_VIDEO_MODEL=
